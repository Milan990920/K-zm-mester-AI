ENVIRONMENT=local
DEBUG=true
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Least-privilege role used by the running application — PostgreSQL Row
# Level Security policies are enforced against it (see docs/02-adatbazis-terv.md).
DATABASE_URL=postgresql+psycopg://kozmu_app:change-me-app-role-password@localhost:5432/kozmu_mester

# Owner/superuser connection used only for running Alembic migrations — RLS
# is never enforced against this role, so it must never be used at runtime.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://kozmu:kozmu@localhost:5432/kozmu_mester

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

GCS_BUCKET_NAME=kozmu-mester-documents
GOOGLE_APPLICATION_CREDENTIALS=

ANTHROPIC_API_KEY=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
