// Adatmodell — a Nyugat-dunántúli Vízügyi Igazgatóság energetikai
// szakreferensi jelentéséhez igazítva (a felhasználó által feltöltött
// "Szakreferens alaptáblázat NYUDUVIZIG 2026.xlsx" táblázat valós
// szerkezete alapján: energianemenkénti havi fogyasztás, telephely-kategória
// szerinti bontás (Épületek / Tevékenység / Szállítás), évenként verziózott
// CO2-tényezők).
//
// A víz/csatorna energianemeket SZÁNDÉKOSAN nem seedeljük alapból: a
// szakreferensi energiajelentés (2015. évi LVII. tv.) kWh-ban kifejezhető
// energiahordozókra vonatkozik, a vízfogyasztásnak nincs értelmes kg CO2/kWh
// tényezője — az EnergyType tábla admin-szerkeszthető, szükség esetén
// bővíthető, de a CO2Factor modell kWh-alapú jellege miatt csak energiahordozó
// típusú energianemekhez ajánlott.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EnergyType {
  id        String   @id @default(cuid())
  code      String   @unique // pl. "electricity", "gas", "wood_chips", "fuel"
  name      String // pl. "Villamos energia"
  badgeColor String  @default("#5C6B63") // hex szín a jelvényekhez/grafikonokhoz
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units             Unit[]
  co2Factors        CO2Factor[]
  measurementPoints MeasurementPoint[]
  invoices          Invoice[]

  @@index([sortOrder])
}

model Unit {
  id           String   @id @default(cuid())
  energyTypeId String
  name         String // pl. "MWh", "GJ", "m3", "liter", "kg"
  kwhPerUnit   Float // átváltási tényező kWh-ra, pl. 1 m3 földgáz ≈ 10,37 kWh
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  energyType EnergyType @relation(fields: [energyTypeId], references: [id], onDelete: Cascade)
  invoices   Invoice[]

  @@unique([energyTypeId, name])
}

// Évenként verziózott CO2-tényező energianemenként — a hivatalos, évente
// publikált kibocsátási tényezők változnak, ezért nem egyetlen statikus
// mező az EnergyType-on, hanem saját, bővíthető tábla.
model CO2Factor {
  id           String   @id @default(cuid())
  energyTypeId String
  year         Int
  kgCo2PerKwh  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  energyType EnergyType @relation(fields: [energyTypeId], references: [id], onDelete: Cascade)

  @@unique([energyTypeId, year])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  taxNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Szakreferensi adatok (2015. évi LVII. tv. szerinti energetikai
  // szakreferens-kötelezettséghez) — mind opcionális, mert nem minden
  // ügyfélre vonatkozik a kötelezettség.
  specialistName             String? // szakreferens neve
  specialistQualification    String? // szakképzettség
  certificateIssuer          String? // tanúsítvány kiállítója
  certificateNumber          String? // tanúsítvány sorszáma
  serviceCompanyName         String? // ha külsős szakreferens-szolgáltató társaságon keresztül biztosított
  serviceCompanyAddress      String?
  serviceCompanyTaxNumber    String?
  relationshipStartDate      DateTime? // jogviszony kezdete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumptionSites ConsumptionSite[]
  invoices         Invoice[]
}

enum SiteCategory {
  BUILDING // Épületek — improduktív energiafelhasználás
  ACTIVITY // Tevékenység — produktív energiafelhasználás
  TRANSPORT // Szállítás — üzemanyag-fogyasztás
}

model ConsumptionSite {
  id         String       @id @default(cuid())
  customerId String
  name       String
  address    String?
  category   SiteCategory
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  measurementPoints MeasurementPoint[]
  invoices          Invoice[]

  @@index([customerId])
}

enum MeasurementType {
  TIME_SERIES // idősoros — okos mérő, 24 órás zónás mérés
  PROFILE // profilos — kisfogyasztású, profil alapján elszámolt hely
}

enum MeasurementPointStatus {
  ACTIVE
  INACTIVE
}

model MeasurementPoint {
  id                  String                  @id @default(cuid())
  consumptionSiteId   String
  podCode             String // villamos energia: EIC-kód; földgáz: "39N" prefix + 16 karakter
  energyTypeId        String
  providerName        String? // kereskedő
  networkOperatorName String? // hálózati engedélyes, ha eltér a kereskedőtől
  meterSerialNumber   String? // tájékoztató jellegű — a számlázott gyári szám mindig a számlán van rögzítve
  measurementType     MeasurementType         @default(PROFILE)
  status              MeasurementPointStatus  @default(ACTIVE)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  consumptionSite ConsumptionSite @relation(fields: [consumptionSiteId], references: [id], onDelete: Cascade)
  energyType      EnergyType      @relation(fields: [energyTypeId], references: [id])
  invoices        Invoice[]

  @@index([consumptionSiteId])
  @@index([energyTypeId])
}

enum InvoiceType {
  SETTLEMENT // elszámoló
  PARTIAL // részszámla
  CONSOLIDATED // göngyölített
  CREDIT // jóváíró
}

enum PaymentStatus {
  OPEN // nyitott
  PAID // fizetve
  OVERDUE // késedelmes
}

enum InvoiceSource {
  MANUAL // kézi rögzítés
  PDF_UPLOAD // feltöltött PDF
}

model Invoice {
  id String @id @default(cuid())

  // Az ügyfél denormalizálva a gyors listázáshoz — mindig a
  // consumptionSite.customerId-vel kell megegyeznie, ezt az app-réteg
  // kényszeríti ki.
  customerId         String
  consumptionSiteId  String
  measurementPointId String
  energyTypeId       String // kötelezően meg kell egyeznie a measurementPoint energiatípusával

  providerName  String
  invoiceNumber String
  issueDate     DateTime
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime?

  quantity          Float
  unitId            String // csak az energyType-hoz tartozó Unit lehet — zod kényszeríti ki
  meterSerialNumber String? // a számlán ténylegesen szereplő gyári szám

  netAmount   Float
  vatRate     Float
  vatAmount   Float
  grossAmount Float
  currency    String @default("HUF")
  unitPrice   Float? // megadható, vagy grossAmount/quantity-ből számolható

  invoiceType   InvoiceType
  paymentStatus PaymentStatus @default(OPEN)

  attachmentPath String? // feltöltött PDF/kép elérési útja
  sourceType     InvoiceSource @default(MANUAL)
  isDraft        Boolean       @default(false) // hiányos számla csak piszkozatként menthető

  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consumptionSite  ConsumptionSite  @relation(fields: [consumptionSiteId], references: [id], onDelete: Cascade)
  measurementPoint MeasurementPoint @relation(fields: [measurementPointId], references: [id], onDelete: Cascade)
  energyType       EnergyType       @relation(fields: [energyTypeId], references: [id])
  unit             Unit             @relation(fields: [unitId], references: [id])

  @@index([customerId])
  @@index([consumptionSiteId])
  @@index([measurementPointId])
  @@index([energyTypeId])
  @@index([measurementPointId, providerName, invoiceNumber]) // duplikátum-figyelmeztetés kereséséhez
}
